APP_NAME=DeepEdu
ENV=development
HOST=127.0.0.1
PORT=8000

# LLM oficial — Amadeus-Verbo (Qwen2.5 PT-BR) via Hugging Face
LLM_PROVIDER=huggingface
LLM_MODEL=amadeusai/Amadeus-Verbo-FI-Qwen2.5-0.5B-PT-BR-Instruct
LLM_TOKENIZER_ID=amadeusai/Amadeus-Verbo-FI-Qwen2.5-0.5B-PT-BR-Instruct
LLM_DEVICE_MAP=auto
LLM_TEMPERATURE=0.3
LLM_MAX_NEW_TOKENS=1024

# Alternativa A (legado): Ollama + Qwen2.5-Math
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-math:1.5b-instruct
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Alternativa B: API OpenAI-compatible (ex. DeepSeek)
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=coloque_sua_chave

OLLAMA_BASE_URL=http://127.0.0.1:11434

DEEPSEEK_API_KEY=coloque_sua_chave
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

PROMPT_FILE=prompts/v1_tutor_em.md
PROMPT_MAX_TOKENS=400
RAG_CONTEXT_MAX_TOKENS=1200
HISTORY_MAX_TOKENS=800
HISTORY_SUMMARY_TRIGGER=600
USER_MESSAGE_MAX_TOKENS=400
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.35
RERANK_ENABLED=true
RERANK_MODEL=unicamp-dl/monoptt5-3b
CHUNK_CHILD_TOKENS=600
CHUNK_OVERLAP_TOKENS=120

# LangSmith
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=deepedu-dev

# Auditoria ECA / LGPD
AUDIT_DB_PATH=./data/audit/audit.db
AUDIT_PHONE_SALT=defina_um_salt_longo_e_aleatorio
AUDIT_FAIL_CLOSED=true
PHONE_ENCRYPTION_KEY=defina_chave_fernet_base64
CONSENT_TERMS_VERSION=1.0
CONSENT_SCHOOL_NAME=Nome da Escola
MESSAGE_DEDUP_TTL_HOURS=48

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=./data/chroma
MATERIALS_DIR=./data/materials
CHAT_DB_PATH=./data/chat_history/chat_history.db
BILLING_DB_PATH=./data/billing/billing.db

BILLING_ENFORCE_SUBSCRIPTION=false
BILLING_TRIAL_DAYS=7
BILLING_PLAN_DAYS=30
BILLING_CURRENCY=BRL
SCHOOL_PLAN_DAYS=30
SCHOOL_PLAN_AMOUNT=499.00

ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_BILLING_AMOUNT=29.90
ASAAS_DEFAULT_BILLING_TYPE=UNDEFINED

ADMIN_API_KEY=defina_uma_chave_forte_aqui
