APP_NAME=deepEdu
ENV=development
HOST=0.0.0.0
PORT=8000

# Perfil LOCAL — Amadeus-Verbo PT-BR (Hugging Face). GPU acelera; CPU funciona.
LLM_PROVIDER=huggingface
LLM_MODEL=amadeusai/Amadeus-Verbo-FI-Qwen2.5-1.5B-PT-BR-Instruct
LLM_TOKENIZER_ID=amadeusai/Amadeus-Verbo-FI-Qwen2.5-1.5B-PT-BR-Instruct
LLM_DEVICE_MAP=auto
LLM_TEMPERATURE=0.3
LLM_MAX_NEW_TOKENS=1024

PROMPT_FILE=prompts/v1_tutor_em.md
PROMPT_MAX_TOKENS=400
RAG_CONTEXT_MAX_TOKENS=1200
HISTORY_MAX_TOKENS=800
HISTORY_SUMMARY_TRIGGER=600
USER_MESSAGE_MAX_TOKENS=400
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.35
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CHUNK_CHILD_TOKENS=600
CHUNK_OVERLAP_TOKENS=120

LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=
LANGCHAIN_PROJECT=deepedu-local

AUDIT_DB_PATH=./data/audit/audit.db
AUDIT_PHONE_SALT=defina_um_salt_longo_e_aleatorio
AUDIT_FAIL_CLOSED=true
PHONE_ENCRYPTION_KEY=defina_chave_fernet_base64
CONSENT_TERMS_VERSION=1.0
CONSENT_SCHOOL_NAME=Nome da Escola
MESSAGE_DEDUP_TTL_HOURS=48

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=./data/chroma
MATERIALS_DIR=./data/materials
CHAT_DB_PATH=./data/chat_history/chat_history.db
BILLING_DB_PATH=./data/billing/billing.db

BILLING_ENFORCE_SUBSCRIPTION=false
BILLING_TRIAL_DAYS=7
BILLING_PLAN_DAYS=30
BILLING_CURRENCY=BRL
SCHOOL_PLAN_DAYS=30
SCHOOL_PLAN_AMOUNT=499.00

ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
ASAAS_BILLING_AMOUNT=29.90
ASAAS_DEFAULT_BILLING_TYPE=UNDEFINED

WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
TWILIO_VALIDATE_SIGNATURE=false
PROFESSOR_WHATSAPP_NUMBERS=
TWILIO_PHONE_NUMBER_SID=
PUBLIC_BASE_URL=http://127.0.0.1:8000

META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=

ADMIN_API_KEY=defina_uma_chave_forte_aqui
