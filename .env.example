APP_NAME=deepEdu
ENV=production
HOST=0.0.0.0
PORT=8000

# LLM — Qwen2.5-Math (padrao: Ollama local)
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-math:1.5b-instruct
LLM_TOKENIZER_ID=Qwen/Qwen2.5-Math-1.5B-Instruct
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TEMPERATURE=0.3
LLM_MAX_NEW_TOKENS=1024

# Alternativas: huggingface | openai_compatible
# LLM_PROVIDER=openai_compatible
# LLM_MODEL=deepseek-chat
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=coloque_sua_chave

DEEPSEEK_API_KEY=coloque_sua_chave
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

PROMPT_FILE=prompts/v1_tutor_em.md
PROMPT_MAX_TOKENS=400
RAG_CONTEXT_MAX_TOKENS=1200
HISTORY_MAX_TOKENS=800
HISTORY_SUMMARY_TRIGGER=600
USER_MESSAGE_MAX_TOKENS=400
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.35
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CHUNK_CHILD_TOKENS=400
CHUNK_PARENT_MAX_TOKENS=400

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGSMITH_API_KEY=coloque_sua_chave_langsmith
LANGCHAIN_PROJECT=deepedu-prod

# Auditoria ECA / LGPD
AUDIT_DB_PATH=./data/audit/audit.db
AUDIT_PHONE_SALT=defina_um_salt_longo_e_aleatorio
AUDIT_FAIL_CLOSED=true
PHONE_ENCRYPTION_KEY=defina_chave_fernet_base64
CONSENT_TERMS_VERSION=1.0
CONSENT_SCHOOL_NAME=Nome da Escola
MESSAGE_DEDUP_TTL_HOURS=48

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHROMA_DIR=./data/chroma
MATERIALS_DIR=./data/materials
CHAT_DB_PATH=./data/chat_history/chat_history.db
BILLING_DB_PATH=./data/billing/billing.db

BILLING_ENFORCE_SUBSCRIPTION=false
BILLING_TRIAL_DAYS=7
BILLING_PLAN_DAYS=30
BILLING_CURRENCY=BRL
SCHOOL_PLAN_DAYS=30
SCHOOL_PLAN_AMOUNT=499.00

ASAAS_API_KEY=coloque_sua_chave_asaas
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=seu_token_webhook_asaas
ASAAS_BILLING_AMOUNT=29.90
ASAAS_DEFAULT_BILLING_TYPE=UNDEFINED

# WhatsApp — twilio ou meta
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_VALIDATE_SIGNATURE=true
PROFESSOR_WHATSAPP_NUMBERS=+5511999990001,+5511999990002
TWILIO_PHONE_NUMBER_SID=PNxxxxxxxxxxxxxxxx
PUBLIC_BASE_URL=https://seu-dominio.com

META_VERIFY_TOKEN=seu_verify_token
META_APP_SECRET=seu_app_secret
META_ACCESS_TOKEN=seu_access_token
META_PHONE_NUMBER_ID=seu_phone_number_id

ADMIN_API_KEY=defina_uma_chave_forte_aqui
